# Pydantic AI model identifier. Examples:
#   openai-chat:gpt-4o-mini
#   anthropic:claude-3-5-sonnet-latest
PAI_MODEL=openai-chat:gpt-4o-mini

# Set the API key expected by your chosen Pydantic AI provider.
OPENAI_API_KEY=sk-your-openai-key

# Optional for OpenAI-compatible gateways when supported by your provider setup.
# OPENAI_BASE_URL=https://api.example.com/v1
